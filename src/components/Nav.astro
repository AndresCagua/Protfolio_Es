---
const links = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Stack', href: '#stack' },
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="monogram" aria-label="Andrés Cagua — inicio">
      <span class="monogram-box">AC</span>
    </a>
    <nav aria-label="Navegación principal">
      <ul class="nav-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="mono nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 13, 15, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }

  .monogram-box {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 9px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .monogram:hover .monogram-box {
    border-color: var(--accent);
    box-shadow: 0 0 22px rgba(198, 241, 53, 0.18);
  }

  .nav-links {
    display: flex;
    gap: clamp(1.1rem, 3.5vw, 2.2rem);
  }

  .nav-link {
    color: var(--muted);
    font-size: 0.68rem;
    transition: color 0.2s var(--ease-out);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .nav-link {
      font-size: 0.6rem;
      letter-spacing: 0.08em;
    }
  }
</style>
