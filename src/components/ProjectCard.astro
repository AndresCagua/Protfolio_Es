---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card reveal">
  <div class="card-top">
    <span class="mono number">{project.number}</span>
    <span class:list={['mono', 'tag', { 'tag-own': project.tag === 'Proyecto propio' }]}>
      {project.tag}
    </span>
  </div>

  <h3 class="card-title">{project.title}</h3>
  <p class="card-desc">{project.description}</p>

  <p class="mono metrics">{project.metrics}</p>

  <ul class="pills" aria-label="Stack utilizado">
    {project.stack.map((tech) => <li class="mono pill">{tech}</li>)}
  </ul>

  {
    project.link && (
      <a
        class="mono card-link"
        href={project.link.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {project.link.label} <span aria-hidden="true">→</span>
      </a>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3.5vw, 2.2rem);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(198, 241, 53, 0.45);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .number {
    color: var(--accent);
    font-size: 0.85rem;
  }

  .tag {
    font-size: 0.6rem;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
  }

  .tag-own {
    color: var(--accent);
    border-color: rgba(198, 241, 53, 0.4);
    background: var(--accent-dim);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .metrics {
    color: var(--accent);
    font-size: 0.68rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill {
    font-size: 0.6rem;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 0.28rem 0.6rem;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .card:hover .pill {
    border-color: var(--hairline-strong);
  }

  .card-link {
    color: var(--text);
    font-size: 0.7rem;
    width: fit-content;
    transition: color 0.2s var(--ease-out);
  }

  .card-link:hover {
    color: var(--accent);
  }
</style>
