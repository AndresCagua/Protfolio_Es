---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class:list={['card', 'reveal', { featured: project.featured }]}>
  <div class="card-top">
    <span class="mono number">{project.number}</span>
    <div class="card-badges">
      {
        project.featured && (
          <span class="mono featured-label" aria-label="Proyecto insignia">Proyecto insignia</span>
        )
      }
      <span class:list={['mono', 'tag', { 'tag-own': project.tag === 'Proyecto propio' }]}>
        {project.tag}
      </span>
    </div>
  </div>

  <h3 class="card-title">{project.title}</h3>
  <p class="card-desc">{project.description}</p>

  <p class="mono metrics">{project.metrics}</p>

  <ul class="pills" aria-label="Stack utilizado">
    {project.stack.map((tech) => <li class="mono pill">{tech}</li>)}
  </ul>

  <div class="card-actions">
    {
      project.link && (
        <a
          class="mono card-link"
          href={project.link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {project.link.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
    {
      project.video && (
        <a
          class="mono card-link video-link"
          href={project.video.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={project.video.label}
          title={project.video.label}
        >
          <svg class="youtube-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z" />
            <path class="youtube-play" d="m9.75 15.5 5.75-3.5-5.75-3.5v7Z" />
          </svg>
          <span>{project.video.label}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3.5vw, 2.2rem);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(198, 241, 53, 0.45);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .featured {
    background:
      linear-gradient(135deg, rgba(198, 241, 53, 0.1), transparent 42%),
      var(--surface);
    border-color: rgba(198, 241, 53, 0.42);
    box-shadow: inset 0 1px 0 rgba(198, 241, 53, 0.18);
  }

  .featured::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--accent);
    content: '';
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .number {
    color: var(--accent);
    font-size: 0.85rem;
  }

  .card-badges {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.6rem;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
  }

  .featured-label {
    color: var(--accent);
    font-size: 0.58rem;
  }

  .tag-own {
    color: var(--accent);
    border-color: rgba(198, 241, 53, 0.4);
    background: var(--accent-dim);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .metrics {
    color: var(--accent);
    font-size: 0.68rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill {
    font-size: 0.6rem;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 0.28rem 0.6rem;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .card:hover .pill {
    border-color: var(--hairline-strong);
  }

  .card-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--text);
    font-size: 0.7rem;
    width: fit-content;
    transition: color 0.2s var(--ease-out);
  }

  .card-link:hover {
    color: var(--accent);
  }

  .youtube-icon {
    width: 1.05rem;
    height: 1.05rem;
    fill: #ff0033;
    transition: transform 0.2s var(--ease-out), fill 0.2s var(--ease-out);
  }

  .video-link:hover .youtube-icon {
    fill: #ff4968;
    transform: scale(1.12);
  }

  .youtube-play {
    fill: white;
  }
</style>
