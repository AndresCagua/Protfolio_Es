---
const items = [
  'Java',
  'Spring Boot',
  'C#',
  '.NET 8',
  'PHP',
  'Laravel 12',
  'Oracle 12c',
  'PostgreSQL',
  'SQL Server',
  'MySQL',
  'MongoDB',
  'Docker',
  'Azure',
  'PL/SQL',
  'Angular',
  'TypeScript',
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {
      [0, 1].map(() => (
        <div class="marquee-group">
          {items.map((item) => (
            <span class="marquee-item mono">
              {item}
              <span class="dot" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    border-block: 1px solid var(--hairline);
    padding-block: 1.1rem;
    overflow: hidden;
    background: var(--surface);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    margin-inline: 1.6rem;
    opacity: 0.7;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
