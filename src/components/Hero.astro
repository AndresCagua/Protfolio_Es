---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/andres-hero.png';

const stats = [
  { value: '+3', label: 'años de experiencia' },
  { value: '450+', label: 'endpoints REST implementados' },
  { value: '5', label: 'motores de bases de datos' },
  { value: '3', label: 'lenguajes de backend' },
];
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="mono eyebrow anim" style="--d: 0ms">Backend Developer · Cuenca, Ecuador</p>
      <h1 class="anim" style="--d: 90ms">Andrés Cagua</h1>
      <p class="role anim" style="--d: 180ms">
        Backend Developer &amp; Especialista en Bases de Datos
      </p>
      <p class="tagline anim" style="--d: 270ms">
        Más de 3 años diseñando APIs y modelos de datos para sistemas que no pueden fallar:
        logística nacional, deporte profesional y telecomunicaciones.
      </p>
      <div class="cta-row anim" style="--d: 360ms">
        <a href="#proyectos" class="btn btn-solid">Ver proyectos</a>
        <a href="#contacto" class="btn btn-ghost">Contáctame</a>
      </div>
    </div>

    <figure class="hero-photo anim" style="--d: 300ms">
      <span class="corner corner-tl mono" aria-hidden="true">[ ANDRÉS ]</span>
      <span class="corner corner-br mono" aria-hidden="true">CUENCA · EC</span>
      <Image
        src={heroPhoto}
        alt="Retrato de Andrés Cagua, Backend Developer"
        width={520}
        format="webp"
        quality={82}
        loading="eager"
      />
    </figure>
  </div>

  <div class="container">
    <dl class="stats anim" style="--d: 480ms">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt class="mono">{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }

  /* Soft radial lime glow behind hero */
  .hero-glow {
    position: absolute;
    top: -22%;
    right: -12%;
    width: 58vw;
    height: 58vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(198, 241, 53, 0.09) 0%, transparent 62%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  /* Staggered load animation */
  .anim {
    opacity: 0;
    transform: translateY(24px);
    animation: rise 0.85s var(--ease-out) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .eyebrow {
    color: var(--accent);
    margin-bottom: 1.4rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8.5vw, 5.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 1.1rem;
  }

  .role {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1.2rem;
  }

  .tagline {
    color: var(--muted);
    max-width: 52ch;
    margin-bottom: 2.2rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.7rem;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      background 0.25s var(--ease-out);
  }

  .btn-solid {
    background: var(--accent);
    color: #0b0d0f;
    border: 1px solid var(--accent);
  }

  .btn-solid:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(198, 241, 53, 0.28);
  }

  .btn-ghost {
    border: 1px solid var(--hairline-strong);
    color: var(--text);
    background: transparent;
  }

  .btn-ghost:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Framed photo with mono corner labels */
  .hero-photo {
    position: relative;
    justify-self: center;
    transform: rotate(2deg);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    padding: 0.6rem;
    background: var(--surface);
    box-shadow: 0 0 60px rgba(198, 241, 53, 0.07);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .hero-photo:hover {
    transform: rotate(0deg);
    box-shadow: 0 0 80px rgba(198, 241, 53, 0.14);
  }

  .hero-photo img {
    border-radius: calc(var(--radius) - 6px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: min(100%, 340px);
  }

  .corner {
    position: absolute;
    font-size: 0.58rem;
    color: var(--muted);
    background: var(--bg);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 5px;
    z-index: 1;
  }

  .corner-tl {
    top: -0.7rem;
    left: 1rem;
  }

  .corner-br {
    bottom: -0.7rem;
    right: 1rem;
    color: var(--accent);
  }

  /* Stats row */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    border-top: 1px solid var(--hairline);
  }

  .stat {
    padding: 1.4rem 1.2rem 0 0;
  }

  .stat + .stat {
    border-left: 1px solid var(--hairline);
    padding-left: 1.4rem;
  }

  .stat dt {
    color: var(--muted);
    font-size: 0.62rem;
    margin-bottom: 0.5rem;
    order: 2;
  }

  .stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.3rem);
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.45rem;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-photo {
      order: -1;
      transform: rotate(0deg);
    }

    .hero-photo img {
      width: min(100%, 280px);
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }

    .stat:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
